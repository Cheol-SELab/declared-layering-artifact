diff --git a/kedro/templates/project/hooks/utils.py b/kedro/templates/project/hooks/utils.py
new file mode 100644
index 0000000..860bd3b
--- /dev/null
+++ b/kedro/templates/project/hooks/utils.py
@@ -0,0 +1,149 @@
+"""Helpers used by the project template hooks to configure add-ons."""
+from __future__ import annotations
+
+import shutil
+import sys
+from pathlib import Path
+
+import click
+
+current_dir = Path.cwd()
+
+ADD_ONS = ["1", "2", "3", "4", "5"]
+
+# Add-on "Linting"
+lint_requirements = "black~=22.0\nruff~=0.0.290\n"
+
+lint_pyproject_requirements = """
+[tool.ruff]
+select = [
+    "F",  # Pyflakes
+    "E",  # Pycodestyle
+    "W",  # Pycodestyle
+    "UP",  # pyupgrade
+    "I",  # isort
+    "PL", # Pylint
+]
+ignore = ["E501"]  # Black takes care of line-too-long
+"""
+
+# Add-on "Testing"
+test_requirements = "pytest-cov~=3.0\npytest-mock>=1.7.1, <2.0\npytest~=7.2\n"
+
+test_pyproject_requirements = """
+[tool.pytest.ini_options]
+addopts = \"\"\"
+--cov-report term-missing \\
+--cov src/{{ cookiecutter.python_package }} -ra
+\"\"\"
+
+[tool.coverage.report]
+fail_under = 0
+show_missing = true
+exclude_lines = ["pragma: no cover", "raise NotImplementedError"]
+"""
+
+# Add-on "Documentation"
+docs_pyproject_requirements = """[project.optional-dependencies]
+docs = [
+    "docutils<0.18.0",
+    "sphinx~=3.4.3",
+    "sphinx_rtd_theme==0.5.1",
+    "nbsphinx==0.8.1",
+    "sphinx-autodoc-typehints==1.11.1",
+    "sphinx_copybutton==0.3.1",
+    "ipykernel>=5.3, <7.0",
+    "Jinja2<3.1.0",
+    "myst-parser~=0.17.2",
+]
+
+"""
+
+
+def _exit_with_error(message: str) -> None:
+    click.secho(message, fg="red", err=True)
+    sys.exit(1)
+
+
+def parse_add_ons_input(add_ons_str: str) -> list[str]:
+    """Parse the add-ons web input into a list of add-on numbers.
+
+    Args:
+        add_ons_str: Input string, e.g. ``"all"``, ``"none"``, ``"1,3,5"``
+            or ``"2-4"``.
+
+    Returns:
+        A list of add-on numbers as strings. Exits with an error message if the
+        input is not a valid selection.
+    """
+    add_ons_str = add_ons_str.strip()
+    if add_ons_str == "all":
+        return list(ADD_ONS)
+    if add_ons_str == "none":
+        return []
+
+    if "-" in add_ons_str:
+        start, _, end = add_ons_str.partition("-")
+        start, end = start.strip(), end.strip()
+        if start.isdigit() and end.isdigit() and int(start) > int(end):
+            _exit_with_error(
+                f"'{add_ons_str}' is an invalid range for project add-ons.\n"
+                "Please ensure range values go from smaller to larger."
+            )
+        selected = [str(i) for i in range(int(start), int(end) + 1)]
+    else:
+        selected = [value.strip() for value in add_ons_str.split(",")]
+
+    for value in selected:
+        if value not in ADD_ONS:
+            _exit_with_error(
+                f"'{value}' is not a valid selection.\n"
+                "Please select from the available add-ons: 1, 2, 3, 4, 5."
+            )
+    return selected
+
+
+def setup_template_add_ons(add_ons_list: list[str], python_package: str = "") -> None:
+    """Keep only the files and settings required by the selected add-ons.
+
+    Must be called from the root of the newly generated project.
+    """
+    if "1" in add_ons_list:
+        _append_to_file(Path("requirements.txt"), lint_requirements)
+        _append_to_file(Path("pyproject.toml"), lint_pyproject_requirements)
+
+    if "2" in add_ons_list:
+        _append_to_file(Path("requirements.txt"), test_requirements)
+        _append_to_file(Path("pyproject.toml"), test_pyproject_requirements)
+    else:
+        _remove_path(Path("tests"))
+
+    if "3" not in add_ons_list:
+        _remove_path(Path("conf") / "logging.yml")
+
+    if "4" not in add_ons_list:
+        _remove_from_file(Path("pyproject.toml"), docs_pyproject_requirements)
+        _remove_path(Path("docs"))
+
+    if "5" not in add_ons_list:
+        _remove_path(Path("data"))
+
+
+def _append_to_file(file_path: Path, content: str) -> None:
+    existing = file_path.read_text(encoding="utf-8")
+    if existing and not existing.endswith("\n"):
+        existing += "\n"
+    file_path.write_text(existing + content, encoding="utf-8")
+
+
+def _remove_from_file(file_path: Path, content: str) -> None:
+    file_path.write_text(
+        file_path.read_text(encoding="utf-8").replace(content, ""), encoding="utf-8"
+    )
+
+
+def _remove_path(path: Path) -> None:
+    if path.is_dir():
+        shutil.rmtree(path)
+    elif path.exists():
+        path.unlink()

@@ -0,0 +1,26 @@
+from pathlib import Path
+
+from kedro.templates.project.hooks.utils import (
+    ADD_ON_NAMES,
+    parse_add_ons_input,
+    setup_template_tools,
+)
+
+
+def main():
+    current_dir = Path.cwd()
+    requirements_file_path = current_dir / "requirements.txt"
+    pyproject_file_path = current_dir / "pyproject.toml"
+
+    add_ons_config = "{{ cookiecutter.add_ons }}"
+    selected_add_ons = parse_add_ons_input(add_ons_config)
+
+    setup_template_tools(selected_add_ons, requirements_file_path, pyproject_file_path)
+
+    if selected_add_ons:
+        names = ", ".join(ADD_ON_NAMES[add_on] for add_on in selected_add_ons)
+        print(f"\nThe following add-ons have been added to your project: {names}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/kedro/templates/project/hooks/utils.py b/kedro/templates/project/hooks/utils.py
new file mode 100644
index 0000000..86e2bee
--- /dev/null
+++ b/kedro/templates/project/hooks/utils.py
@@ -0,0 +1,149 @@
+import re
+import shutil
+import sys
+from pathlib import Path
+
+current_dir = Path.cwd()
+
+# Add-on identifiers
+LINT = "1"
+TESTS = "2"
+LOG = "3"
+DOCS = "4"
+DATA = "5"
+ADD_ON_NAMES = {
+    LINT: "Linting",
+    TESTS: "Testing",
+    LOG: "Custom Logging",
+    DOCS: "Documentation",
+    DATA: "Example Pipeline Data Structure",
+}
+VALID_ADD_ONS = list(ADD_ON_NAMES)
+
+lint_requirements = "black~=22.0\nruff~=0.0.290\n"
+
+lint_pyproject_requirements = """
+[tool.ruff]
+select = [
+    "F",  # Pyflakes
+    "E",  # Pycodestyle
+    "W",  # Pycodestyle
+    "UP",  # pyupgrade
+    "I",  # isort
+    "PL", # Pylint
+]
+ignore = ["E501"]  # Black takes care of line-too-long
+"""
+
+test_requirements = "pytest-cov~=3.0\npytest-mock>=1.7.1, <2.0\npytest~=7.2\n"
+
+test_pyproject_requirements = """
+[tool.pytest.ini_options]
+addopts = \"\"\"
+--cov-report term-missing \\
+--cov src/{{ cookiecutter.python_package }} -ra
+\"\"\"
+
+[tool.coverage.report]
+fail_under = 0
+show_missing = true
+exclude_lines = ["pragma: no cover", "raise NotImplementedError"]
+"""
+
+docs_pyproject_requirements = """
+docs = [
+    "docutils<0.18.0",
+    "sphinx~=3.4.3",
+    "sphinx_rtd_theme==0.5.1",
+    "nbsphinx==0.8.1",
+    "sphinx-autodoc-typehints==1.11.1",
+    "sphinx_copybutton==0.3.1",
+    "ipykernel>=5.3, <7.0",
+    "Jinja2<3.1.0",
+    "myst-parser~=0.17.2",
+]
+"""
+
+OPTIONAL_DEPS_HEADER = "[project.optional-dependencies]\n"
+
+
+def _fail(message):
+    print(message, file=sys.stderr)
+    sys.exit(1)
+
+
+def parse_add_ons_input(add_ons_str):
+    """Parse the add-ons input string into a list of selected add-on identifiers.
+
+    Accepts "all", "none", comma-separated values ("1,2,4") and ranges ("2-4").
+    Prints an error to stderr and exits if the input is invalid.
+    """
+    add_ons_str = add_ons_str.strip()
+    if add_ons_str == "all":
+        return list(VALID_ADD_ONS)
+    if add_ons_str == "none":
+        return []
+
+    selected = []
+    if re.fullmatch(r"\s*\d+\s*-\s*\d+\s*", add_ons_str):
+        start, end = (part.strip() for part in add_ons_str.split("-"))
+        if int(start) > int(end):
+            _fail(
+                f"'{add_ons_str}' is an invalid range for project add-ons.\n"
+                "Please ensure range values go from smaller to larger."
+            )
+        selected = [str(i) for i in range(int(start), int(end) + 1)]
+    else:
+        selected = [item.strip() for item in add_ons_str.split(",") if item.strip()]
+
+    for item in selected:
+        if item not in VALID_ADD_ONS:
+            _fail(
+                f"'{item}' is not a valid selection.\n"
+                f"Please select from the available add-ons: {', '.join(VALID_ADD_ONS)}."
+            )
+
+    return sorted(set(selected), key=int)
+
+
+def setup_template_tools(selected_add_ons, requirements_file_path, pyproject_file_path):
+    """Remove or extend template files according to the selected add-ons."""
+    if LINT in selected_add_ons:
+        _append(requirements_file_path, lint_requirements)
+        _append(pyproject_file_path, lint_pyproject_requirements)
+
+    if TESTS in selected_add_ons:
+        _append(requirements_file_path, test_requirements)
+        _append(pyproject_file_path, test_pyproject_requirements)
+    else:
+        _remove_dir(current_dir / "tests")
+
+    if DOCS in selected_add_ons:
+        content = pyproject_file_path.read_text(encoding="utf-8")
+        content = content.replace(
+            OPTIONAL_DEPS_HEADER, OPTIONAL_DEPS_HEADER + docs_pyproject_requirements, 1
+        )
+        pyproject_file_path.write_text(content, encoding="utf-8")
+    else:
+        _remove_dir(current_dir / "docs")
+
+    if LOG not in selected_add_ons:
+        _remove_file(current_dir / "conf" / "logging.yml")
+
+    if DATA not in selected_add_ons:
+        _remove_dir(current_dir / "data")
+
+
+def _append(path, text):
+    with open(path, "a", encoding="utf-8") as file:
+        file.write(text)
+
+
+def _remove_dir(path):
+    if path.exists():
+        shutil.rmtree(str(path))
+
+
+def _remove_file(path):
+    if path.exists():
+        path.unlink()

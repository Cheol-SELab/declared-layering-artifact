diff --git a/kedro/templates/project/hooks/post_gen_project.py b/kedro/templates/project/hooks/post_gen_project.py
new file mode 100644
index 0000000..de97e48
--- /dev/null
+++ b/kedro/templates/project/hooks/post_gen_project.py
@@ -0,0 +1,18 @@
+"""Cookiecutter hook that removes the files of add-ons that were not selected."""
+from pathlib import Path
+
+from kedro.templates.project.hooks.utils import (
+    parse_add_ons_input,
+    setup_template_add_ons,
+)
+
+
+def main():
+    add_ons_str = "{{ cookiecutter.add_ons }}"
+    project_path = Path.cwd()
+    selected = parse_add_ons_input(add_ons_str)
+    setup_template_add_ons(selected, project_path)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/kedro/templates/project/hooks/utils.py b/kedro/templates/project/hooks/utils.py
new file mode 100644
index 0000000..9fb99e4
--- /dev/null
+++ b/kedro/templates/project/hooks/utils.py
@@ -0,0 +1,172 @@
+"""Helpers for the post-generation hook of the default project template."""
+from __future__ import annotations
+
+import shutil
+import sys
+from pathlib import Path
+
+import click
+
+ADD_ONS_NAMES = {
+    "1": "Linting",
+    "2": "Testing",
+    "3": "Custom Logging",
+    "4": "Documentation",
+    "5": "Data Structure",
+}
+
+lint_requirements = "black~=22.0\nruff~=0.0.290\n"
+
+lint_pyproject_requirements = """
+[tool.ruff]
+select = [
+    "F",  # Pyflakes
+    "E",  # Pycodestyle
+    "W",  # Pycodestyle
+    "UP",  # pyupgrade
+    "I",  # isort
+    "PL", # Pylint
+]
+ignore = ["E501"]  # Black takes care of line-too-long
+"""
+
+test_requirements = "pytest-cov~=3.0\npytest-mock>=1.7.1, <2.0\npytest~=7.2\n"
+
+test_pyproject_requirements = """
+[tool.pytest.ini_options]
+addopts = \"\"\"
+--cov-report term-missing \\
+--cov src/{{ cookiecutter.python_package }} -ra
+\"\"\"
+
+[tool.coverage.report]
+fail_under = 0
+show_missing = true
+exclude_lines = ["pragma: no cover", "raise NotImplementedError"]
+"""
+
+docs_pyproject_requirements = """
+[project.optional-dependencies]
+docs = [
+    "docutils<0.18.0",
+    "sphinx~=3.4.3",
+    "sphinx_rtd_theme==0.5.1",
+    "nbsphinx==0.8.1",
+    "sphinx-autodoc-typehints==1.11.1",
+    "sphinx_copybutton==0.3.1",
+    "ipykernel>=5.3, <7.0",
+    "Jinja2<3.1.0",
+    "myst-parser~=0.17.2",
+]
+"""
+
+
+def parse_add_ons_input(add_ons_str: str) -> list[str]:
+    """Parse the add-ons input string into a list of selected add-on numbers.
+
+    Args:
+        add_ons_str: Input string, e.g. ``"all"``, ``"none"``, ``"1,3"`` or ``"2-4"``.
+
+    Returns:
+        A list of add-on numbers as strings. Exits with an error message if the
+        selection is not valid.
+    """
+    if add_ons_str == "all":
+        return list(ADD_ONS_NAMES)
+    if add_ons_str == "none":
+        return []
+
+    # Split by comma
+    add_ons_choices = add_ons_str.split(",")
+    selected: list[str] = []
+
+    for choice in add_ons_choices:
+        choice = choice.strip()
+        if "-" in choice:
+            start, end = (part.strip() for part in choice.split("-"))
+            if not _validate_range(start, end):
+                sys.exit(1)
+            selected.extend(str(i) for i in range(int(start), int(end) + 1))
+        else:
+            selected.append(choice)
+
+    validate_add_ons(selected)
+    return selected
+
+
+def _validate_range(start: str, end: str) -> bool:
+    """Check that a range is ordered and made of valid add-ons."""
+    if int(start) > int(end):
+        message = (
+            f"'{start}-{end}' is an invalid range for project add-ons.\n"
+            "Please ensure range values go from smaller to larger."
+        )
+        click.secho(message, fg="red", err=True)
+        return False
+    # Check that the endpoints are valid selections
+    for value in (start, end):
+        if value not in ADD_ONS_NAMES:
+            _print_invalid_selection(value)
+            return False
+    return True
+
+
+def validate_add_ons(selected: list[str]) -> None:
+    """Exit with an error message if any selected add-on is not available."""
+    for value in selected:
+        if value not in ADD_ONS_NAMES:
+            _print_invalid_selection(value)
+            sys.exit(1)
+
+
+def _print_invalid_selection(value: str) -> None:
+    message = (
+        f"'{value}' is not a valid selection.\n"
+        f"Please select from the available add-ons: {', '.join(ADD_ONS_NAMES)}."
+    )
+    click.secho(message, fg="red", err=True)
+
+
+def get_add_on_names(selected: list[str]) -> list[str]:
+    """Return the display names of the selected add-ons."""
+    return [ADD_ONS_NAMES[value] for value in selected if value in ADD_ONS_NAMES]
+
+
+def setup_template_add_ons(selected: list[str], project_path: Path) -> None:
+    """Keep only the template files belonging to the selected add-ons."""
+    requirements_path = project_path / "requirements.txt"
+    pyproject_path = project_path / "pyproject.toml"
+
+    if "1" in selected:
+        _append(requirements_path, lint_requirements)
+        _append(pyproject_path, lint_pyproject_requirements)
+
+    if "2" in selected:
+        _append(requirements_path, test_requirements)
+        _append(pyproject_path, test_pyproject_requirements)
+    else:
+        _remove(project_path / "tests")
+
+    if "3" not in selected:
+        _remove(project_path / "conf" / "logging.yml")
+
+    if "4" in selected:
+        _append(pyproject_path, docs_pyproject_requirements)
+    else:
+        _remove(project_path / "docs")
+
+    if "5" not in selected:
+        _remove(project_path / "data")
+
+
+def _append(path: Path, text: str) -> None:
+    with path.open("a", encoding="utf-8") as file:
+        file.write(text)
+
+
+def _remove(path: Path) -> None:
+    if path.is_dir():
+        shutil.rmtree(path)
+    elif path.exists():
+        path.unlink()
+

+"""Helpers used by the post-generation hook of the default project template."""
+from __future__ import annotations
+
+import re
+import shutil
+import sys
+from pathlib import Path
+
+current_dir = Path.cwd()
+
+# Add-on numbers as presented to the user in prompts.yml
+ADD_ONS = {
+    "1": "Linting",
+    "2": "Testing",
+    "3": "Logging",
+    "4": "Documentation",
+    "5": "Data Structure",
+}
+
+# Locations (relative to the project root) that belong to each add-on
+ADD_ON_PATHS = {
+    "2": ["tests"],
+    "3": ["conf/logging.yml"],
+    "4": ["docs"],
+    "5": ["data"],
+}
+
+lint_requirements = "black~=22.0\nruff~=0.0.290\n"
+
+lint_pyproject_requirements = """
+[tool.ruff]
+select = [
+    "F",  # Pyflakes
+    "E",  # Pycodestyle
+    "W",  # Pycodestyle
+    "UP",  # pyupgrade
+    "I",  # isort
+    "PL", # Pylint
+]
+ignore = ["E501"]  # Black takes care of line-too-long
+"""
+
+test_requirements = "pytest-cov~=3.0\npytest-mock>=1.7.1, <2.0\npytest~=7.2\n"
+
+test_pyproject_requirements = """
+[tool.pytest.ini_options]
+addopts = \"\"\"
+--cov-report term-missing \\
+--cov src/{{ cookiecutter.python_package }} -ra
+\"\"\"
+
+[tool.coverage.report]
+fail_under = 0
+show_missing = true
+exclude_lines = ["pragma: no cover", "raise NotImplementedError"]
+"""
+
+_DOCS_PYPROJECT_SECTION = re.compile(
+    r"\[project\.optional-dependencies\]\ndocs = \[.*?\n\]\n\n", re.DOTALL
+)
+
+
+def _fail(message: str) -> None:
+    print(message, file=sys.stderr)
+    sys.exit(1)
+
+
+def parse_add_ons_input(add_ons_str: str) -> list[str]:
+    """Parse the user's add-ons selection into a list of add-on numbers.
+
+    Accepts ``all``, ``none``, comma-separated values (``1,3``) and ranges
+    (``2-4``). Exits with an error message on invalid input.
+    """
+    add_ons_str = add_ons_str.strip()
+    if add_ons_str == "all":
+        return list(ADD_ONS)
+    if add_ons_str == "none":
+        return []
+
+    selected: list[str] = []
+    for token in add_ons_str.split(","):
+        token = token.strip()
+        if "-" in token:
+            start, _, end = token.partition("-")
+            if not (start.strip().isdigit() and end.strip().isdigit()):
+                _fail(f"'{token}' is not a valid selection.")
+            if int(start) > int(end):
+                _fail(
+                    f"'{token}' is an invalid range for project add-ons.\n"
+                    "Please ensure range values go from smaller to larger."
+                )
+            selected.extend(str(i) for i in range(int(start), int(end) + 1))
+        else:
+            selected.append(token)
+
+    for add_on in selected:
+        if add_on not in ADD_ONS:
+            _fail(
+                f"'{add_on}' is not a valid selection.\n"
+                f"Please select from the available add-ons: {', '.join(ADD_ONS)}."
+            )
+
+    return sorted(set(selected))
+
+
+def _append_to_file(file_path: Path, content: str) -> None:
+    with open(file_path, "a", encoding="utf-8") as file:
+        file.write(content)
+
+
+def _remove_path(path: Path) -> None:
+    if path.is_dir():
+        shutil.rmtree(path)
+    elif path.exists():
+        path.unlink()
+
+
+def setup_add_ons(add_ons_str: str, project_dir: Path | None = None) -> list[str]:
+    """Remove the parts of the generated project that belong to add-ons which were
+    not selected, and add the requirements of the selected ones."""
+    project_dir = project_dir or current_dir
+    selected = parse_add_ons_input(add_ons_str)
+
+    requirements_path = project_dir / "requirements.txt"
+    pyproject_path = project_dir / "pyproject.toml"
+
+    for add_on, paths in ADD_ON_PATHS.items():
+        if add_on not in selected:
+            for path in paths:
+                _remove_path(project_dir / path)
+
+    if "1" in selected:
+        _append_to_file(requirements_path, lint_requirements)
+        _append_to_file(pyproject_path, lint_pyproject_requirements)
+
+    if "2" in selected:
+        _append_to_file(requirements_path, test_requirements)
+        _append_to_file(pyproject_path, test_pyproject_requirements)
+
+    if "4" not in selected:
+        content = pyproject_path.read_text(encoding="utf-8")
+        pyproject_path.write_text(
+            _DOCS_PYPROJECT_SECTION.sub("", content), encoding="utf-8"
+        )
+
+    return selected

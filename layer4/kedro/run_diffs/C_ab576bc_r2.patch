diff --git a/kedro/templates/project/hooks/utils.py b/kedro/templates/project/hooks/utils.py
new file mode 100644
index 0000000..af6faa7
--- /dev/null
+++ b/kedro/templates/project/hooks/utils.py
@@ -0,0 +1,152 @@
+"""Helpers for the add-ons flow of the default ``kedro new`` project template."""
+from __future__ import annotations
+
+import shutil
+import sys
+from pathlib import Path
+
+import click
+
+ADD_ON_NAMES = {
+    "1": "Linting",
+    "2": "Testing",
+    "3": "Logging",
+    "4": "Documentation",
+    "5": "Data Structure",
+}
+VALID_ADD_ONS = list(ADD_ON_NAMES)
+
+LINT_REQUIREMENTS = "black~=22.0\nruff~=0.0.290\n"
+
+LINT_PYPROJECT = """
+[tool.ruff]
+select = [
+    "F",  # Pyflakes
+    "E",  # Pycodestyle
+    "W",  # Pycodestyle
+    "UP",  # pyupgrade
+    "I",  # isort
+    "PL", # Pylint
+]
+ignore = ["E501"]  # Black takes care of line-too-long
+"""
+
+TEST_REQUIREMENTS = "pytest-cov~=3.0\npytest-mock>=1.7.1, <2.0\npytest~=7.2\n"
+
+TEST_PYPROJECT = """
+[tool.pytest.ini_options]
+addopts = \"\"\"
+--cov-report term-missing \\
+--cov src/{{ cookiecutter.python_package }} -ra
+\"\"\"
+
+[tool.coverage.report]
+fail_under = 0
+show_missing = true
+exclude_lines = ["pragma: no cover", "raise NotImplementedError"]
+"""
+
+DOCS_PYPROJECT = """docs = [
+    "docutils<0.18.0",
+    "sphinx~=3.4.3",
+    "sphinx_rtd_theme==0.5.1",
+    "nbsphinx==0.8.1",
+    "sphinx-autodoc-typehints==1.11.1",
+    "sphinx_copybutton==0.3.1",
+    "ipykernel>=5.3, <7.0",
+    "Jinja2<3.1.0",
+    "myst-parser~=0.17.2",
+]
+"""
+
+OPTIONAL_DEPS_HEADER = "[project.optional-dependencies]\n"
+
+# Paths (relative to the project root) that exist only when the add-on is selected.
+ADD_ON_PATHS = {
+    "2": ["tests"],
+    "3": ["conf/logging.yml"],
+    "4": ["docs"],
+    "5": ["data"],
+}
+
+
+def _exit_with_error(message: str) -> None:
+    click.secho(message, fg="red", err=True)
+    sys.exit(1)
+
+
+def parse_add_ons_input(add_ons_str: str) -> list[str]:
+    """Parse the add-ons selection ('1,3', '2-4', 'all' or 'none') into a list of
+    add-on numbers as strings. Exits with an error message on invalid input."""
+    add_ons_str = add_ons_str.strip()
+    if add_ons_str == "all":
+        return list(VALID_ADD_ONS)
+    if add_ons_str == "none":
+        return []
+
+    def _check(value: str) -> str:
+        value = value.strip()
+        if value not in VALID_ADD_ONS:
+            _exit_with_error(
+                f"'{value}' is not a valid selection.\n"
+                f"Please select from the available add-ons: {', '.join(VALID_ADD_ONS)}."
+            )
+        return value
+
+    selected: set[str] = set()
+    for token in add_ons_str.split(","):
+        token = token.strip()
+        if "-" in token:
+            start, _, end = token.partition("-")
+            start, end = _check(start), _check(end)
+            if int(start) > int(end):
+                _exit_with_error(
+                    f"'{token}' is an invalid range for project add-ons.\n"
+                    "Please ensure range values go from smaller to larger."
+                )
+            selected.update(str(i) for i in range(int(start), int(end) + 1))
+        else:
+            selected.add(_check(token))
+
+    return sorted(selected)
+
+
+def get_add_on_names(add_ons_str: str) -> list[str]:
+    """Return the display names of the selected add-ons."""
+    return [ADD_ON_NAMES[add_on] for add_on in parse_add_ons_input(add_ons_str)]
+
+
+def _append(path: Path, text: str) -> None:
+    with path.open("a", encoding="utf-8") as file:
+        file.write(text)
+
+
+def setup_add_ons(project_dir: Path, add_ons_str: str) -> None:
+    """Remove the files of unselected add-ons and add the requirements of the
+    selected ones to ``requirements.txt`` and ``pyproject.toml``."""
+    selected = parse_add_ons_input(add_ons_str)
+    requirements = project_dir / "requirements.txt"
+    pyproject = project_dir / "pyproject.toml"
+
+    if "1" in selected:
+        _append(requirements, LINT_REQUIREMENTS)
+        _append(pyproject, LINT_PYPROJECT)
+    if "2" in selected:
+        _append(requirements, TEST_REQUIREMENTS)
+        _append(pyproject, TEST_PYPROJECT)
+    if "4" in selected:
+        content = pyproject.read_text(encoding="utf-8")
+        content = content.replace(
+            OPTIONAL_DEPS_HEADER, OPTIONAL_DEPS_HEADER + DOCS_PYPROJECT, 1
+        )
+        pyproject.write_text(content, encoding="utf-8")
+
+    for add_on, relative_paths in ADD_ON_PATHS.items():
+        if add_on in selected:
+            continue
+        for relative in relative_paths:
+            path = project_dir / relative
+            if path.is_dir():
+                shutil.rmtree(path, ignore_errors=True)
+            else:
+                path.unlink(missing_ok=True)

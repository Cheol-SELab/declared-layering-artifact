+    # The handler states operate in the loop's time, so that is what must be advanced.
+    loop = asyncio.get_running_loop()
+    original_time = loop.time
+    offset = 0.0
+
+    def fake_time() -> float:
+        return original_time() + offset
+
+    mocker.patch.object(loop, 'time', fake_time)
+
     with freezegun.freeze_time() as frozen:
 
         async def sleep_substitute(*_, **__):
+            nonlocal offset
+            offset += 123
             frozen.tick(123)
 
         sleep = mocker.patch('kopf._cogs.aiokits.aiotime.sleep', wraps=sleep_substitute)

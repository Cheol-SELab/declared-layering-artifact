+def _doomed_error(
+        handler: Handler,
+        state: HandlerState,
+        delay: float | int | None,
+) -> Exception | None:
+    """
+    Detect if the next retry is bound to fail on the retries/timeout limits.
+
+    If so, the handler is finalised now instead of being retried in vain.
+    """
+    if handler.retries is not None and state.retries + 1 >= handler.retries:
+        return HandlerRetriesError(f"{handler} has exceeded {state.retries + 1} retries.")
+    if handler.timeout is not None:
+        next_runtime = state.runtime.total_seconds() + (delay or 0)
+        if next_runtime >= handler.timeout:
+            return HandlerTimeoutError(f"{handler} has timed out after {datetime.timedelta(seconds=next_runtime)}.")
+    return None
+
+

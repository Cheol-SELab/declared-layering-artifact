+def _loop_time() -> float:
+    """ The current time of the running event loop (a monotonic clock, not a wall clock). """
+    try:
+        return asyncio.get_running_loop().time()
+    except RuntimeError:  # no running loop: the same clock as in the default event loops.
+        return time.monotonic()
+
+
+def _make_basetime() -> datetime.datetime:
+    """ The wall-clock moment corresponding to the loop time of zero. """
+    return datetime.datetime.now(tz=datetime.timezone.utc) - datetime.timedelta(seconds=_loop_time())
+
+
+def _to_loop_time(val: datetime.datetime, basetime: datetime.datetime) -> float:
+    val = val if val.tzinfo is not None else val.replace(tzinfo=datetime.timezone.utc)
+    return (val - basetime).total_seconds()
+
+
+def _to_wall_time(val: float, basetime: datetime.datetime) -> datetime.datetime:
+    return basetime + datetime.timedelta(seconds=val)
+

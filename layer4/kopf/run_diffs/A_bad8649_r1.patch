+def _doomed_to_fail(
+        handler: Handler,
+        state: HandlerState,
+        delay: float | int | None,
+) -> HandlerTimeoutError | HandlerRetriesError | None:
+    """
+    Detect if the next retry is certain to hit the retries/timeout limits.
+
+    If so, there is no point in sleeping & retrying: the handler is finished now.
+    """
+    if handler.retries is not None and state.retries + 1 >= handler.retries:
+        return HandlerRetriesError(f"{handler} has exceeded {handler.retries} retries.")
+    if handler.timeout is not None:
+        next_runtime = state.runtime.total_seconds() + (delay or 0)
+        if next_runtime >= handler.timeout:
+            return HandlerTimeoutError(f"{handler} has timed out after {handler.timeout} seconds.")
+    return None
+

@@ -165,9 +166,17 @@ async def test_delays_are_simulated(settings, activity, mocker):
         param=None, errors=None, timeout=None, retries=3, backoff=None,
     ))
 
+    # The handler states measure time by the event loop's clock, which freezegun does not touch.
+    loop = asyncio.get_running_loop()
+    real_time = loop.time
+    offset = 0.0
+    mocker.patch.object(loop, 'time', lambda: real_time() + offset)
+
     with freezegun.freeze_time() as frozen:
 
         async def sleep_substitute(*_, **__):
+            nonlocal offset
+            offset += 123
             frozen.tick(123)
 
         sleep = mocker.patch('kopf._cogs.aiokits.aiotime.sleep', wraps=sleep_substitute)

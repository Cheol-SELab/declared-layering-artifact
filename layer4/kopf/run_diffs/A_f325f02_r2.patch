+    """ Get the initial delay: either a constant or a result of a (sync) callback. """
+    if callable(handler.initial_delay):
+        kwargs = dict(cause.kwargs)
+        kwargs.setdefault('param', handler.param)
+        return handler.initial_delay(**kwargs)
+    return handler.initial_delay
+
